# Settings shared by every board.

CONFIG_IDF_TARGET="esp32s3"

# Console over the S3's built-in USB (no UART chip on either board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Fast boot (see ESP-IDF "Speed Optimization > Reducing startup time") ---
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
# App logs: warnings by default, but INFO can be turned on at runtime
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Not set on purpose: CONFIG_BOOT_ROM_LOG_ALWAYS_OFF burns an eFuse (irreversible).

# PSRAM present on both boards; skip the slow (~1 s per 4 MB) boot memory test
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# C++ subset: no exceptions, no RTTI. These are ESP-IDF's defaults, set here so they stay
# that way. See README "C++ conventions".
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Wi-Fi alone takes the app to ~900 KB; the default 1 MB app partition is too tight.
# (Needs >= 2 MB flash: both boards have more.)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# app_main runs the whole push-to-talk flow (protocol messages, snprintf, playback); the 3.5 KB
# default overflowed. Logged as "stack overflow in task main".
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Initial TCP retransmission timeout, used before a connection has measured its round-trip time:
# exactly when we connect and push the PSRAM backlog. The 1.5 s default showed up as 1.5 s stalls
# right after boot (2026-10-24); LAN round trips are 5-20 ms.
CONFIG_LWIP_TCP_RTO_TIME=300
